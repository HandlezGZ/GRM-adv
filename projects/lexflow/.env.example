# LexFlow Configuration (Local Project Environment)
PROJECT_NAME="LexFlow"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_URL="http://localhost:8000"

# Database (defaults to local SQLite if empty)
DATABASE_URL="sqlite:///./lexflow.db"

# Classification Strategy: rules | llm | hybrid
CLASSIFICATION_MODE="rules"
LLM_CONFIDENCE_THRESHOLD=0.70

# Optional LLM Provider Configuration (leave empty for deterministic mode)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
